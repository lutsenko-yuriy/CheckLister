{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PROJECT_DIR}/scripts/onboard/gate.sh\" SessionStart", "timeout": 5}
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/demo/demo.py\" session-start", "timeout": 5}
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PROJECT_DIR}/scripts/onboard/gate.sh\" UserPromptExpansion", "timeout": 5}
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PROJECT_DIR}/scripts/onboard/gate.sh\" PreToolUse", "timeout": 5}
        ]
      }
    ]
  }
}
